{
  "name": "dinah",
  "displayName": "Dinah",
  "description": "Dinah in VS Code: see which workbench this folder resolves to and which dinah binary the editor is talking to.",
  "version": "1.0.0",
  "publisher": "paulmooreparks",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulmooreparks/dinah.git"
  },
  "bugs": {
    "url": "https://github.com/paulmooreparks/dinah/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/workbench.md",
    "onView:dinah.workbenchView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dinah",
          "title": "%manifest.viewsContainers.dinah.title%",
          "icon": "media/dinah.svg"
        }
      ]
    },
    "views": {
      "dinah": [
        {
          "id": "dinah.workbenchView",
          "name": "%manifest.views.dinah.workbenchView.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary == 'missing'",
        "contents": "%manifest.viewsWelcome.binaryMissing.contents%"
      },
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary == 'ok' && dinah.workbench == 'none'",
        "contents": "%manifest.viewsWelcome.workbenchNone.contents%"
      },
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary == 'ok' && dinah.workbench == 'ambiguous'",
        "contents": "%manifest.viewsWelcome.workbenchAmbiguous.contents%"
      },
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary == 'ok' && dinah.workbench == 'unknown'",
        "contents": "%manifest.viewsWelcome.workbenchUnknown.contents%"
      },
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary == 'ok' && dinah.workbench != 'none' && dinah.workbench != 'ambiguous' && dinah.workbench != 'ok' && dinah.workbench != 'unknown'",
        "contents": "%manifest.viewsWelcome.workbenchSearching.contents%"
      },
      {
        "view": "dinah.workbenchView",
        "when": "dinah.binary != 'missing' && dinah.binary != 'ok'",
        "contents": "%manifest.viewsWelcome.binarySearching.contents%"
      }
    ],
    "commands": [
      {
        "command": "dinah.tree.refresh",
        "title": "%manifest.command.dinah.tree.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "dinah.tree.openCard",
        "title": "%manifest.command.dinah.tree.openCard.title%"
      },
      {
        "command": "dinah.tree.claim",
        "title": "%manifest.command.dinah.tree.claim.title%"
      },
      {
        "command": "dinah.tree.move",
        "title": "%manifest.command.dinah.tree.move.title%"
      },
      {
        "command": "dinah.tree.release",
        "title": "%manifest.command.dinah.tree.release.title%"
      },
      {
        "command": "dinah.tree.block",
        "title": "%manifest.command.dinah.tree.block.title%"
      },
      {
        "command": "dinah.tree.unblock",
        "title": "%manifest.command.dinah.tree.unblock.title%"
      },
      {
        "command": "dinah.tree.copyCardRef",
        "title": "%manifest.command.dinah.tree.copyCardRef.title%"
      },
      {
        "command": "dinah.tree.checkWorkbench",
        "title": "%manifest.command.dinah.tree.checkWorkbench.title%"
      },
      {
        "command": "dinah.tree.copyWorkbenchPath",
        "title": "%manifest.command.dinah.tree.copyWorkbenchPath.title%"
      },
      {
        "command": "dinah.tree.editWorkbenchDefinition",
        "title": "%manifest.command.dinah.tree.editWorkbenchDefinition.title%"
      },
      {
        "command": "dinah.tree.editColumnInstructions",
        "title": "%manifest.command.dinah.tree.editColumnInstructions.title%"
      },
      {
        "command": "dinah.tree.openAttachment",
        "title": "%manifest.command.dinah.tree.openAttachment.title%"
      },
      {
        "command": "dinah.tree.newCard",
        "title": "%manifest.command.dinah.tree.newCard.title%"
      },
      {
        "command": "dinah.tree.attachFile",
        "title": "%manifest.command.dinah.tree.attachFile.title%"
      },
      {
        "command": "dinah.tree.pull",
        "title": "%manifest.command.dinah.tree.pull.title%"
      },
      {
        "command": "dinah.tree.openInstructions",
        "title": "%manifest.command.dinah.tree.openInstructions.title%"
      },
      {
        "command": "dinah.walkthrough.openFirstSessionGuide",
        "title": "%manifest.command.dinah.walkthrough.openFirstSessionGuide.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dinah.tree.openCard",
          "when": "false"
        },
        {
          "command": "dinah.tree.claim",
          "when": "false"
        },
        {
          "command": "dinah.tree.move",
          "when": "false"
        },
        {
          "command": "dinah.tree.release",
          "when": "false"
        },
        {
          "command": "dinah.tree.block",
          "when": "false"
        },
        {
          "command": "dinah.tree.unblock",
          "when": "false"
        },
        {
          "command": "dinah.tree.copyCardRef",
          "when": "false"
        },
        {
          "command": "dinah.tree.checkWorkbench",
          "when": "false"
        },
        {
          "command": "dinah.tree.copyWorkbenchPath",
          "when": "false"
        },
        {
          "command": "dinah.tree.editWorkbenchDefinition",
          "when": "false"
        },
        {
          "command": "dinah.tree.editColumnInstructions",
          "when": "false"
        },
        {
          "command": "dinah.tree.openAttachment",
          "when": "false"
        },
        {
          "command": "dinah.tree.newCard",
          "when": "false"
        },
        {
          "command": "dinah.tree.attachFile",
          "when": "false"
        },
        {
          "command": "dinah.tree.pull",
          "when": "false"
        },
        {
          "command": "dinah.tree.openInstructions",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dinah.tree.refresh",
          "when": "view == dinah.workbenchView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dinah.tree.claim",
          "when": "view == dinah.workbenchView && viewItem == dinah.card.ready.claim",
          "group": "1_flow@1"
        },
        {
          "command": "dinah.tree.move",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.card\\.(ready|active)/",
          "group": "1_flow@2"
        },
        {
          "command": "dinah.tree.block",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.card\\.(ready|active)/",
          "group": "1_flow@3"
        },
        {
          "command": "dinah.tree.release",
          "when": "view == dinah.workbenchView && viewItem == dinah.card.active",
          "group": "1_flow@1"
        },
        {
          "command": "dinah.tree.unblock",
          "when": "view == dinah.workbenchView && viewItem == dinah.card.blocked",
          "group": "1_flow@1"
        },
        {
          "command": "dinah.tree.copyCardRef",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.card\\./",
          "group": "3_copy@1"
        },
        {
          "command": "dinah.tree.checkWorkbench",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.workbench(Root|Candidate|Forest)$/",
          "group": "1_workbench@1"
        },
        {
          "command": "dinah.tree.copyWorkbenchPath",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.workbench(Root|Candidate|Forest)$/",
          "group": "1_workbench@2"
        },
        {
          "command": "dinah.tree.editWorkbenchDefinition",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.workbench(Root|Candidate|Forest)$/",
          "group": "1_workbench@3"
        },
        {
          "command": "dinah.tree.attachFile",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.workbench(Root|Candidate|Forest)$/",
          "group": "1_workbench@4"
        },
        {
          "command": "dinah.tree.editColumnInstructions",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.column(\\.open|\\.full)?(\\.pull)?$/",
          "group": "1_column@1"
        },
        {
          "command": "dinah.tree.pull",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.column\\.(open|full)\\.pull$/",
          "group": "1_column@2"
        },
        {
          "command": "dinah.tree.newCard",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.column\\.open(\\.pull)?$/",
          "group": "1_column@3"
        },
        {
          "command": "dinah.tree.attachFile",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.column\\./",
          "group": "1_column@4"
        },
        {
          "command": "dinah.tree.attachFile",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.card\\./",
          "group": "2_attachment@1"
        },
        {
          "command": "dinah.tree.openInstructions",
          "when": "view == dinah.workbenchView && viewItem =~ /^dinah\\.card\\./",
          "group": "2_view@1"
        }
      ]
    },
    "configuration": {
      "title": "%manifest.configuration.title%",
      "properties": {
        "dinah.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%manifest.configuration.dinah.path.markdownDescription%"
        },
        "dinah.workbench": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%manifest.configuration.dinah.workbench.markdownDescription%"
        },
        "dinah.pollIntervalSeconds": {
          "type": "integer",
          "default": 10,
          "minimum": 2,
          "scope": "resource",
          "markdownDescription": "%manifest.configuration.dinah.pollIntervalSeconds.markdownDescription%"
        },
        "dinah.watchFiles": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%manifest.configuration.dinah.watchFiles.markdownDescription%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dinah.firstSession",
        "title": "%manifest.walkthrough.firstSession.title%",
        "description": "%manifest.walkthrough.firstSession.description%",
        "steps": [
          {
            "id": "dinah.firstSession.readGuide",
            "title": "%manifest.walkthrough.firstSession.step.readGuide.title%",
            "description": "%manifest.walkthrough.firstSession.step.readGuide.description%",
            "media": {
              "markdown": "media/walkthrough-first-session.md"
            },
            "completionEvents": [
              "onCommand:dinah.walkthrough.openFirstSessionGuide"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "generate": "node esbuild.mjs --generate-only",
    "compile": "npm run generate && node esbuild.mjs",
    "watch": "npm run generate && node esbuild.mjs --watch",
    "check-types": "npm run generate && tsc --noEmit",
    "lint": "eslint src test",
    "compile-tests": "npm run generate && tsc --project tsconfig.test.json",
    "test:unit": "npm run compile-tests && node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile-tests && npm run compile && node out/test/integration/runTest.js",
    "package": "npm run check-types && npm run lint && npm run compile && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.3.2",
    "mocha": "^11.0.1",
    "typescript": "^5.7.2"
  }
}
