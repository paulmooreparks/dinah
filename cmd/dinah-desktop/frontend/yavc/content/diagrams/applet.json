{
  "name": "diagrams",
  "title": "Diagrams",
  "version": "0.44.0",
  "instances": 9,
  "description": "Draw diagrams from D2 and Mermaid text and JSON Canvas files, with the drawing beside the text, and export them as pictures.",
  "license": "Apache-2.0",
  "src": "diagrams.js",
  "css": "diagrams.css",
  "icon": "icon.svg",
  "page": {
    "body": "page.html"
  },
  "window": {
    "shape": "0.78,0.82",
    "min": "560,400"
  },
  "handles": {
    "diagram": {
      "param": "file",
      "extra": [
        "view",
        "initial-view"
      ]
    }
  },
  "actions": "actions.json",
  "continuity": true,
  "wants": [
    "snapshot",
    "fs",
    "config",
    "commandToolbar"
  ],
  "tags": [
    "site",
    "writing"
  ]
