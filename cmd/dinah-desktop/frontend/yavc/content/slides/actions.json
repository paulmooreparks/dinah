{
  "id": "yavc.slides",
  "version": "1.3.0",
  "apiVersion": 1,
  "title": "Slides",
  "description": "Slide decks as Markdown files: read, build and change a deck, move through it, and present it. The deck a live action works on is the one open in Slides; parse and make work on text alone.",
  "module": "actions.js",
  "actions": [
    {
      "ref": "yavc.slides/table@1",
      "title": "Edit Selected Table",
      "description": "Apply a table operation at the current rich selection in Visual or Split view. Alignment changes every cell in the selected columns.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "row-above",
              "row-below",
              "column-before",
              "column-after",
              "delete-row",
              "delete-column",
              "delete-table",
              "align-default",
              "align-left",
              "align-center",
              "align-right"
            ]
          }
        },
        "required": [
          "op"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "changed": {
            "const": true
          }
        },
        "required": [
          "changed"
        ]
      },
      "capabilities": [
        "files.write"
      ],
      "changes": "document",
      "replay": "once"
    },
    {
      "ref": "yavc.slides/format@1",
      "title": "Format Selection",
      "description": "Apply formatting at the current text or rich selection. Quote toggles a block quote while preserving nested content.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "quote",
              "bold",
              "italic",
              "underline",
              "strike",
              "code",
              "highlight",
              "superscript",
              "subscript",
              "bullets",
              "numbers",
              "paragraph",
              "h1",
              "h2",
              "h3",
              "h4",
              "h5",
              "h6"
            ]
          }
        },
        "required": [
          "op"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formatted": {
            "const": true
          }
        },
        "required": [
          "formatted"
        ]
      },
      "capabilities": [
        "files.write"
      ],
      "changes": "document",
      "replay": "once"
    },
    {
      "ref": "yavc.slides/define@1",
      "title": "Read Custom Shortcode Definitions",
      "description": "Read the deck's validated custom shortcode definitions, shared definitions, parameter metadata, source ranges and problems. Ranges use UTF-16 positions in the whole deck or shared source.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "capabilities": [
        "files.read"
      ],
      "changes": "none",
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/parse@1",
      "title": "Parse a Deck",
      "description": "Read a deck's Markdown into its front matter and its slides. Slides are divided by a line of three dashes; a {{slide:\u00e2\u20ac\u00a6}} line gives a slide's settings; {{notes}} \u00e2\u20ac\u00a6 {{/notes}} is what the speaker says.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/parsed",
        "$defs": {
          "parsed": {
            "$ref": "#/$defs/deck"
          },
          "deck": {
            "type": "object",
            "required": [
              "front",
              "slides"
            ],
            "properties": {
              "front": {
                "$ref": "#/$defs/front"
              },
              "slides": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slide"
                }
              }
            },
            "$defs": {}
          },
          "front": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "theme": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "transition": {
                "type": "string"
              }
            }
          },
          "slide": {
            "type": "object",
            "required": [
              "index",
              "title",
              "settings",
              "text"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      },
      "capabilities": [],
      "changes": "none",
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/make@1",
      "title": "Make a Deck",
      "description": "Write a deck's Markdown from its front matter and its slides. Each slide is Markdown, optionally with settings (layout: title, section, content, two-column, image, quote or blank; background, a colour; image, a picture's address; reveal: steps; transition: none, fade or slide) and notes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slides"
        ],
        "properties": {
          "front": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "theme": {
                "enum": [
                  "plain",
                  "paper",
                  "midnight"
                ]
              },
              "size": {
                "enum": [
                  "16:9",
                  "4:3"
                ]
              },
              "transition": {
                "enum": [
                  "none",
                  "fade",
                  "slide"
                ]
              },
              "subject": {
                "type": "string",
                "maxLength": 2000
              },
              "keywords": {
                "type": "string",
                "maxLength": 2000
              },
              "lang": {
                "type": "string",
                "pattern": "^([A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*)?$"
              },
              "date": {
                "type": "string",
                "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
              }
            }
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "capabilities": [],
      "changes": "none",
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/present@1",
      "title": "Open a Deck in Slides",
      "description": "Open Slides on a deck file for the person to see, at a slide; with present true, presenting from it.",
      "handles": "present",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "slide": {
            "type": "integer",
            "minimum": 1
          },
          "present": {
            "type": "boolean"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opened"
        ],
        "properties": {
          "opened": {
            "const": true
          },
          "view": {
            "enum": [
