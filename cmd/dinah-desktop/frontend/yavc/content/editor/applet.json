{
  "name": "editor",
  "title": "Editor",
  "version": "46.37.1",
  "description": "Edit text and source code. Markdown documents are drawn in Docs.",
  "license": "Apache-2.0",
  "src": "editor.js",
  "css": "editor.css",
  "icon": "icon.svg",
  "page": {
    "body": "page.html"
  },
  "window": {
    "shape": "0.6,0.8"
  },
