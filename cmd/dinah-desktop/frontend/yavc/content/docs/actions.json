{
  "id": "yavc.docs",
  "version": "1.0.0",
  "apiVersion": 1,
  "title": "Docs",
  "description": "Markdown document authoring, source access and page layout.",
  "actions": [
    {
      "ref": "yavc.docs/theme@1",
      "title": "Set Document Theme",
      "description": "Set the current editable document theme as one undoable front-matter edit. Authored typography and styles retain their overrides.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "enum": [
              "plain",
              "manuscript",
              "report",
              "letter"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "theme"
        ],
        "properties": {
          "theme": {
            "type": "string"
          }
        }
      },
      "capabilities": [],
      "replay": "once"
    },
    {
      "ref": "yavc.docs/new-template@1",
      "title": "New Document from Stock Template",
      "description": "Create an independent unsaved document from a bundled starter under the host's document-window policy. Custom Markdown files can be chosen through File, New from Template.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template"
        ],
        "properties": {
          "template": {
            "enum": [
              "blank",
              "report",
              "letter",
              "manuscript",
              "meeting"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "capabilities": [],
      "replay": "once"
    },
    {
      "ref": "yavc.docs/page-setup@1",
      "title": "Set Page Layout",
      "description": "Change the current Markdown document page size, orientation or margins as one undoable source edit. Dimensions and returned margins are in points, in left, top, right, bottom order.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "page": {
            "type": "string",
            "maxLength": 64
          },
          "orientation": {
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "margins": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "width",
          "height",
          "margins"
        ],
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "margins": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "capabilities": [],
      "replay": "once"
    },
    {
      "ref": "yavc.docs/export@1",
      "title": "Export Document",
      "description": "Export the current Markdown document as editable Word DOCX or a PDF with selectable text. Exclusions and draft notes are removed before layout. Returns a file artifact without the Markdown source. Unresolved review annotations require an explicit reviewPolicy; the source stays unchanged.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format"
        ],
        "properties": {
          "format": {
            "enum": [
              "docx",
              "pdf"
            ]
          },
          "reviewPolicy": {
            "enum": [
              "accepted",
              "original"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "format",
          "blocks",
          "warnings"
        ],
        "properties": {
          "format": {
            "enum": [
              "docx",
              "pdf"
            ]
          },
          "blocks": {
            "type": "integer"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "capabilities": [
        "artifact.create",
        "files.read"
      ],
      "replay": "pure"
    },
    {
      "ref": "yavc.docs/outline@1",
      "title": "Read Document Outline",
      "description": "Read the current Markdown document headings and their section ranges. Positions use UTF-16. Parent, previous and next are zero-based entry indexes, or -1. The revision is required when moving a section.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "entries",
          "revision"
        ]
      },
      "capabilities": [
        "files.read"
      ],
      "replay": "pure"
    },
    {
      "ref": "yavc.docs/move-section@1",
      "title": "Move Document Section",
      "description": "Move a heading and its descendants among same-level siblings under the same parent. Read outline first and supply its revision. The complete move is one Undo operation.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "direction": {
            "enum": [
              "up",
              "down"
            ]
          },
          "before": {
            "type": "integer",
            "minimum": 0
          },
          "after": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "from",
          "revision"
        ],
        "oneOf": [
          {
            "required": [
              "direction"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "before"
                  ]
                },
                {
                  "required": [
                    "after"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "before"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "after"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "after"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "before"
                  ]
                }
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "moved": {
            "type": "boolean"
          },
          "from": {
            "type": "integer"
          }
        },
        "required": [
          "moved",
          "from"
        ]
      },
      "capabilities": [
        "files.write"
      ],
      "replay": "once"
    },
    {
      "ref": "yavc.docs/table@1",
      "title": "Edit Selected Table",
      "description": "Apply a table operation at the current rich selection in Visual or Split view. Alignment changes every cell in the selected columns.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "row-above",
              "row-below",
              "column-before",
              "column-after",
              "delete-row",
              "delete-column",
              "delete-table",
              "align-default",
              "align-left",
              "align-center",
              "align-right"
            ]
          }
        },
        "required": [
          "op"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "changed": {
            "const": true
          }
        },
        "required": [
          "changed"
        ]
      },
      "capabilities": [
        "files.write"
      ],
      "replay": "once"
    },
    {
      "ref": "yavc.docs/format@1",
      "title": "Format Selection",
      "description": "Apply formatting at the current text or rich selection. Quote toggles a block quote while preserving nested content.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
